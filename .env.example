# Demo Mode works without external credentials.
DEMO_MODE=true

# Official eBay Browse API (active listings only)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE=EBAY_NL

# Configurable official Cardmarket public files
CARDMARKET_CATALOGUE_URL=
CARDMARKET_PRICE_GUIDE_URL=

# Marktplaats public-page monitor. Credentials are not used in this mode.
MARKTPLAATS_ACCESS_MODE=public_monitor
MARKTPLAATS_SCAN_INTERVAL_MINUTES=15
MARKTPLAATS_SEARCH_QUERIES=
MARKTPLAATS_POSTCODE=
MARKTPLAATS_DISTANCE_KM=100

# Official Keepa API only. Never expose this key to browser code.
KEEPA_API_KEY=
KEEPA_SCAN_INTERVAL_MINUTES=15
KEEPA_DISCOVERY_INTERVAL_MINUTES=180
AMAZON_DEFAULT_MARKETPLACE=NL
AMAZON_MARKETS=NL,DE,BE,FR,IT,ES

# Live cart intents must be signed; demo tokens are clearly marked unsigned
CART_TOKEN_SECRET=
