# Production-only UI. Test fixtures are isolated under the automated test suite.

# Official eBay Browse API (active listings only)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE=EBAY_NL

# Required for eBay Production keyset compliance. The endpoint must exactly
# match the public HTTPS URL saved in the eBay developer portal. Keep the
# 32-80 character verification token server-side and secret.
EBAY_MARKETPLACE_DELETION_ENDPOINT=
EBAY_MARKETPLACE_DELETION_HMAC_SECRET=
EBAY_MARKETPLACE_DELETION_VERIFICATION_TOKEN=

# Configurable official Cardmarket public files
CARDMARKET_CATALOGUE_URL=
CARDMARKET_PRICE_GUIDE_URL=

# Marktplaats public-page monitor. Credentials are not used in this mode.
MARKTPLAATS_ACCESS_MODE=public_monitor
MARKTPLAATS_SCAN_INTERVAL_MINUTES=15
MARKTPLAATS_SEARCH_QUERIES=
MARKTPLAATS_POSTCODE=
MARKTPLAATS_DISTANCE_KM=100

# Official Keepa API only. Never expose this key to browser code.
KEEPA_API_KEY=
KEEPA_SCAN_INTERVAL_MINUTES=15
KEEPA_DISCOVERY_INTERVAL_MINUTES=180
AMAZON_DEFAULT_MARKETPLACE=NL
AMAZON_MARKETS=NL,DE,BE,FR,IT,ES

# Official Reddit OAuth API only. Community names stay configurable.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=tcg-scout/1.0 (contact: your-email@example.com)
REDDIT_COMMUNITIES=
REDDIT_SCAN_INTERVAL_MINUTES=15

# Official Discord bot only. A separate event-driven bot service must use
# explicit guild and channel allowlists; user tokens/self-bots are prohibited.
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ALLOWLIST=
DISCORD_CHANNEL_ALLOWLIST=
DISCORD_INGEST_URL=
COMMUNITY_INGEST_SECRET=

# Pseudonymisation and temporary raw-excerpt retention.
COMMUNITY_AUTHOR_HASH_SALT=
COMMUNITY_RAW_RETENTION_HOURS=24

# Live cart intents require a server-side signing secret. Keep it out of browser code.
CART_TOKEN_SECRET=

# Only this verified ChatGPT account can view real community messages and configure sources.
COMMUNITY_ADMIN_EMAIL=
# Persistent worker delivery queue (not used by the web app).
DISCORD_STATE_DIR=.discord-state
