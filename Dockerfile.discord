FROM node:24-bookworm-slim
WORKDIR /app
COPY lib/ ./lib/
COPY scripts/community-discord-worker.mjs ./scripts/community-discord-worker.mjs
RUN mkdir -p /app/.discord-state && chown node:node /app/.discord-state
USER node
ENV NODE_ENV=production
ENV DISCORD_STATE_DIR=/app/.discord-state
CMD ["node", "--experimental-strip-types", "scripts/community-discord-worker.mjs"]
