{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tcg-scout-mcp-bridge",
  "main": "./src/index.ts",
  "compatibility_date": "2026-09-06",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "minify": true,
  "vars": {
    "TCG_SCOUT_BASE_URL": "https://tcg-scout-arcane-market-hunter.xorqe.chatgpt.site",
    "ALLOWED_GITHUB_USER_ID": "56995940",
  },
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "3266c36700834cfcbc34536d5f5fc2a7",
    },
  ],
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05,
    },
  },
}
